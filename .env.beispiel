# Abschrift für den Host (nach /poolio/docker/mekotools-quizablage/.env)
#
# Nur die Sperre braucht hier Eintraege — die Quizablage selbst liest keine
# Geheimnisse. Diese Zeilen gehoeren in /poolio/docker/mekotools-auth/.env:
#
#   TINYAUTH_APPS_QUIZABLAGE_CONFIG_DOMAIN=quizablage.mekotools.de
#   TINYAUTH_APPS_QUIZABLAGE_OAUTH_WHITELIST=<erlaubte Anmeldeadresse>
#
# Danach nur den Sperrdienst neu erzeugen (nie den ganzen Stapel):
#   docker compose up -d --no-deps tinyauth
