# Abschrift für den Host (nach /poolio/docker/mekotools-fuizstash/.env)
#
# Nur die Sperre braucht hier Eintraege — die Fuizstash selbst liest keine
# Geheimnisse. Diese Zeilen gehoeren in /poolio/docker/mekotools-auth/.env:
#
#   TINYAUTH_APPS_FUIZSTASH_CONFIG_DOMAIN=fuizstash.mekotools.de
#   TINYAUTH_APPS_FUIZSTASH_OAUTH_WHITELIST=<erlaubte Anmeldeadresse>
#
# Danach nur den Sperrdienst neu erzeugen (nie den ganzen Stapel):
#   docker compose up -d --no-deps tinyauth
